# Environment Configuration Example for Razorpay AI Revenue Recovery Control Tower

APP_NAME="Razorpay AI Revenue Recovery Control Tower"
VERSION="1.0.0"
ENV="development"

# Database URL (Defaults to SQLite for local zero-friction setup, supports PostgreSQL)
# PostgreSQL Example: DATABASE_URL="postgresql://user:password@localhost:5432/razorpay_recovery"
DATABASE_URL="sqlite:///./revenue_recovery.db"

# LLM API Key (OpenAI / Gemini / Anthropic API compatible)
# Replace with real API key for live LLM reasoning, or leave blank to automatically use deterministic fallback engine
LLM_API_KEY="your-llm-api-key-here"
